# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
.env
.env.*

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Model weights — canonical checkpoints are tracked; other .pt files ignored
*.pt
!checkpoints/router_v1_mobilenet_v3_small.pt
!checkpoints/leaf_v1_efficientnet_b0.pt
!checkpoints/fruit_v1_yolov8n.pt
checkpoints/*.pth
checkpoints/*.onnx
checkpoints/*.bak
checkpoints/*.corrupted.*

# Ultralytics training outputs
runs/

# Training / eval logs (regenerated by scripts)
logs/

# Generated at inference (leaf Grad-CAM overlays)
results/gradcam_overlays/*.jpg
results/gradcam_overlays/*.png

# Raw dataset junction targets (download datasets locally; see data/README.md)
data/leaf_raw/*
!data/leaf_raw/.gitkeep
data/fruit_raw/*
!data/fruit_raw/.gitkeep

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkouts/

# Gradio app outputs (the committed v1 examples in results/inference_results/ stay tracked)
results/inference_results/gradcam/
results/inference_results/*.jpg
results/inference_results/app_log.json

# External validation images (Google Drive) — validation only, never training
data/external_validation/

# pytest
.pytest_cache/
